#version 450

#extension GL_EXT_control_flow_attributes : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
} p;

const uint BLOCK_M_SIZE = 4;
const uint BLOCK_N_SIZE = 4;
const uint BLOCK_K_SIZE = 4;

shared float buf_a[BLOCK_M_SIZE][BLOCK_K_SIZE];
shared float buf_b[BLOCK_N_SIZE][BLOCK_K_SIZE];

shared float buf_sum[BLOCK_M_SIZE][BLOCK_N_SIZE][BLOCK_K_SIZE];

void main() {
    uint m_i = (gl_LocalInvocationID.x) & 3;
    uint n_i = (gl_LocalInvocationID.x >> 2) & 3;
    uint k_i = (gl_LocalInvocationID.x >> 4) & 3;

    uint m_b = gl_WorkGroupID.x / (p.N/4);
    uint n_b = gl_WorkGroupID.x % (p.N/4);

    uint m = m_b*BLOCK_M_SIZE + m_i;
    uint n = n_b*BLOCK_N_SIZE + n_i;

    const uint SUM_COUNT = 32;

    float sum[SUM_COUNT];
    for (uint i = 0; i < SUM_COUNT; i++) {
        sum[i] = 0.0;
    }

    for (uint k_b = 0; k_b < p.K/BLOCK_K_SIZE; k_b+=SUM_COUNT) {
        for (uint i = 0; i < SUM_COUNT; i++) {
            uint k = (k_b+i)*BLOCK_K_SIZE + k_i;
            sum[i] = fma(data_a[m*p.K + k], data_b[n*p.K + k], sum[i]);
        }
    }

    for (uint i = 1; i < SUM_COUNT; i++) {
        sum[0] += sum[i];
    }

    buf_sum[m_i][n_i][k_i] = sum[0];

    barrier();

    if (k_i == 0) {
        for (uint k_i = 1; k_i < BLOCK_K_SIZE; k_i++) {
            sum[0] += buf_sum[m_i][n_i][k_i];
        }
        data_d[n*p.M + m] = sum[0];
    }
}
