#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_clustered : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
} p;

const uint BLOCK_M_SIZE = 2;
const uint BLOCK_N_SIZE = 2;
const uint BLOCK_K_SIZE = 8;

void main() {
    uint k_i = (gl_SubgroupInvocationID) & 7;
    uint m_i = (gl_SubgroupInvocationID >> 3) & 1;
    uint n_i = (gl_SubgroupInvocationID >> 4) & 1;

    uint m_b = gl_WorkGroupID.x / (p.N/2);
    uint n_b = gl_WorkGroupID.x % (p.N/2);

    uint m = m_b*BLOCK_M_SIZE + m_i;
    uint n = n_b*BLOCK_N_SIZE + n_i;

    const uint SUM_COUNT = 32;

    float sum[SUM_COUNT];
    for (uint i = 0; i < SUM_COUNT; i++) {
        sum[i] = 0.0;
    }

    for (uint k_b = 0; k_b < p.K/BLOCK_K_SIZE; k_b+=SUM_COUNT) {
        for (uint i = 0; i < SUM_COUNT; i++) {
            uint k = (k_b+i)*BLOCK_K_SIZE + k_i;
            float data_a_m_k = data_a[m*p.K + k];
            float data_b_n_k = data_b[n*p.K + k];
            sum[i] = fma(data_a[m*p.K + k], data_b[n*p.K + k], sum[i]);
        }
    }

    for (uint i = 1; i < SUM_COUNT; i++) {
        sum[0] += sum[i];
    }

    subgroupBarrier();

    float d = 0;
    d = subgroupClusteredAdd(sum[0], 8);
    if (k_i == 0) {
        data_d[n*p.M + m] = d;
    }
}
