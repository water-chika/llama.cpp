#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_clustered : enable

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) writeonly buffer D {float data_d[];};

layout (push_constant) uniform parameter
{
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
} p;

const uint THREAD_M_SIZE = 16;
const uint THREAD_N_SIZE = 10;
const uint THREAD_K_SIZE = 16;

float[THREAD_M_SIZE] get_thread_cache_a(uint m_thread_index, uint k_thread_index, uint k) {
    float thread_cache_a[THREAD_M_SIZE];
    for (uint m = 0; m < THREAD_M_SIZE; m++) {
        thread_cache_a[m] = data_a[(m_thread_index*THREAD_M_SIZE + m)*p.K + (k_thread_index*THREAD_K_SIZE+k)];
    }
    return thread_cache_a;
}
float[THREAD_N_SIZE] get_thread_cache_b(uint n_thread_index, uint k_thread_index, uint k) {
    float thread_cache_b[THREAD_N_SIZE];
    [[unroll]] for (uint n = 0; n < THREAD_N_SIZE; n++) {
        thread_cache_b[n] = data_b[(n_thread_index*THREAD_N_SIZE + n)*p.K + (k_thread_index*THREAD_K_SIZE+k)];
    }
    return thread_cache_b;
}

float[THREAD_M_SIZE*THREAD_N_SIZE]
thread_mul(uint m_thread_index, uint n_thread_index, uint k_thread_index) {
    float thread_cache_a[THREAD_M_SIZE];
    float thread_cache_b[THREAD_N_SIZE];
    float thread_cache_d[THREAD_M_SIZE*THREAD_N_SIZE];

    for (uint n = 0; n < THREAD_N_SIZE; n++) {
        for (uint m = 0; m < THREAD_M_SIZE; m++) {
            thread_cache_d[n*THREAD_M_SIZE + m] = 0;
        }
    }

    for (uint k = 0; k < THREAD_K_SIZE; k++) {
        thread_cache_a = get_thread_cache_a(m_thread_index, k_thread_index, k);
        thread_cache_b = get_thread_cache_b(n_thread_index, k_thread_index, k);
        for (uint n = 0; n < THREAD_N_SIZE; n++) {
            for (uint m = 0; m < THREAD_M_SIZE; m++) {
                thread_cache_d[n*THREAD_M_SIZE + m] = fma(thread_cache_a[m], thread_cache_b[n], thread_cache_d[n*THREAD_M_SIZE + m]);
            }
        }
    }
    return thread_cache_d;
}

const uint SUBGROUP_M_SIZE = 8;
const uint SUBGROUP_N_SIZE = 4;
const uint SUBGROUP_K_SIZE = 1;

void subgroup_mul(uint m_subgroup_index, uint n_subgroup_index) {
    uint m_thread_index = gl_SubgroupInvocationID & 0x7;
    uint n_thread_index = gl_SubgroupInvocationID >> 3;
    uint k_thread_index = 0;
    float thread_cache_d[THREAD_M_SIZE*THREAD_N_SIZE] =
        thread_mul(
            m_subgroup_index*SUBGROUP_M_SIZE + m_thread_index,
            n_subgroup_index*SUBGROUP_N_SIZE + n_thread_index,
            k_thread_index);
    for (uint n = 0; n < THREAD_N_SIZE; n++) {
        for (uint m = 0; m < THREAD_M_SIZE; m++) {
            data_d[
                (n_subgroup_index*SUBGROUP_N_SIZE*THREAD_N_SIZE + n_thread_index*THREAD_N_SIZE + n)*p.M +
                (m_subgroup_index*SUBGROUP_M_SIZE*THREAD_M_SIZE + m_thread_index*THREAD_M_SIZE + m)] = thread_cache_d[n*THREAD_M_SIZE + m];
        }
    }
}

void main() {
    uint m_subgroup_index = gl_WorkGroupID.x;
    uint n_subgroup_index = gl_WorkGroupID.y;
    subgroup_mul(m_subgroup_index, n_subgroup_index);
}
